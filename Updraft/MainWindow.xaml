<Window
    x:Class="Updraft.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Updraft"
    Title="Updraft">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    OpenPaneLength="220"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="Nav_SelectionChanged">

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox x:Name="Search" QueryIcon="Find" PlaceholderText="Filter updates"
                            TextChanged="Search_TextChanged" QuerySubmitted="Search_QuerySubmitted" />
        </NavigationView.AutoSuggestBox>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavUp" Content="Upgrades" Tag="upgrade">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE898;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavInstalled" Content="Installed" Tag="installed">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavDiscover" Content="Discover" Tag="discover">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- package list -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="24,20,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="Subtitle" Opacity="0.65" />
                    </StackPanel>
                    <ProgressRing x:Name="Ring" Grid.Column="1" Width="22" Height="22" IsActive="False" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button x:Name="RefreshBtn" Grid.Column="2" Click="Refresh_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView x:Name="PkgList" Grid.Row="1" ItemsSource="{x:Bind Items}"
                          SelectionMode="Single" SelectionChanged="PkgList_SelectionChanged"
                          Padding="12,0,8,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Pkg">
                            <Grid Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Name}" />
                                        <Border Grid.Column="1" CornerRadius="8" Padding="6,0" BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind SourceVisibility}"
                                                BorderBrush="{x:Bind SourceBrush}">
                                            <TextBlock Text="{x:Bind SourceLabel}" FontSize="10"
                                                       Foreground="{x:Bind SourceBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind Id}" /><Run Text="   ·   " /><Run Text="{x:Bind VersionText}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyMsg" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6" TextAlignment="Center" />
            </Grid>

            <!-- detail pane -->
            <Border Grid.Row="0" Grid.Column="1" Margin="0,16,16,8" Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="DEmpty" Text="Select a package to see details" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer x:Name="DPanel" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DId" Opacity="0.65" TextWrapping="Wrap" />
                            <TextBlock x:Name="DDesc" TextWrapping="Wrap" Margin="0,10,0,10" />

                            <TextBlock Text="Details" Opacity="0.65" FontSize="12" Margin="0,4,0,4" />
                            <Grid RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Installed" />
                                <TextBlock x:Name="DInst" Grid.Column="1" FontWeight="SemiBold" />
                                <TextBlock Text="Latest version" Grid.Row="1" />
                                <TextBlock x:Name="DLatest" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                                <TextBlock Text="Publisher" Grid.Row="2" />
                                <TextBlock x:Name="DPub" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Licence" Grid.Row="3" />
                                <TextBlock x:Name="DLic" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Homepage" Grid.Row="4" />
                                <HyperlinkButton x:Name="DHome" Grid.Row="4" Grid.Column="1" Padding="0" />
                            </Grid>

                            <TextBlock Text="Terminal command" Opacity="0.65" FontSize="12" Margin="0,16,0,4" />
                            <Border CornerRadius="6" Padding="12" Background="#1E1F24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DCmd" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                               Foreground="#D7DAE0" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button x:Name="DCopy" Grid.Column="1" Content="Copy" Click="DCopy_Click"
                                            VerticalAlignment="Top" Margin="10,0,0,0" />
                                </Grid>
                            </Border>

                            <Button x:Name="DAction" Style="{StaticResource AccentButtonStyle}" Margin="0,14,0,0"
                                    Click="DAction_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- action bar -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Padding="24,10,16,10" ColumnSpacing="12"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SelectAll" Content="Select all" Click="SelectAll_Click" MinWidth="0" />
                <TextBlock x:Name="SelCount" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" />
                <CheckBox x:Name="AdminChk" Grid.Column="2" Content="Run as administrator" MinWidth="0" />
                <Button x:Name="CopyBtn" Grid.Column="3" Content="Copy script" Click="CopyScript_Click" IsEnabled="False" />
                <Button x:Name="RunBtn" Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                        <TextBlock x:Name="RunText" Text="Run in terminal" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- status bar -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Padding="24,4,16,6">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Opacity="0.75" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
