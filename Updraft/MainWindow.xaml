<Window
    x:Class="Updraft.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Updraft"
    Title="Updraft">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    OpenPaneLength="220"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    SelectionChanged="Nav_SelectionChanged">

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox x:Name="Search" QueryIcon="Find" PlaceholderText="Filter updates"
                            TextChanged="Search_TextChanged" QuerySubmitted="Search_QuerySubmitted" />
        </NavigationView.AutoSuggestBox>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavUp" Content="Upgrades" Tag="upgrade">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE898;" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="UpBadge" Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavInstalled" Content="Installed" Tag="installed">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavDiscover" Content="Discover" Tag="discover">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavHistory" Content="History" Tag="history">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="340" />
                <ColumnDefinition x:Name="DetailCol" Width="2*" MinWidth="320" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- package list -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="24,20,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Subtitle" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel x:Name="ListTools" Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <ComboBox x:Name="SortBox" Header="" MinWidth="150" SelectedIndex="0"
                                  SelectionChanged="SortBox_SelectionChanged" ToolTipService.ToolTip="Sort by">
                            <ComboBoxItem Content="Sort: Name A–Z" />
                            <ComboBoxItem Content="Sort: Name Z–A" />
                            <ComboBoxItem Content="Sort: Source" />
                            <ComboBoxItem Content="Sort: Id" />
                        </ComboBox>
                        <ComboBox x:Name="SourceBox" MinWidth="130" SelectedIndex="0"
                                  SelectionChanged="SourceBox_SelectionChanged" ToolTipService.ToolTip="Filter by source">
                            <ComboBoxItem Content="All sources" />
                        </ComboBox>
                        <CheckBox x:Name="ShowSkippedChk" Content="Show skipped" MinWidth="0" Click="ShowSkipped_Click" />
                    </StackPanel>
                    <ProgressRing x:Name="Ring" Grid.Column="1" Width="22" Height="22" IsActive="False" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <DropDownButton x:Name="BackupBtn" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                    AutomationProperties.Name="Backup and restore"
                                    ToolTipService.ToolTip="Backup and restore: save your app list, or reinstall apps from a saved list">
                        <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Export installed apps…" Click="Export_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Restore from file…" Click="Import_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="RefreshBtn" Grid.Column="3" Click="Refresh_Click" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Rescan (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearHistoryBtn" Grid.Column="3" Click="ClearHistory_Click" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Clear history" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="WingetBar" Grid.Row="1" Margin="24,0,16,8" IsOpen="False" IsClosable="False"
                         Severity="Error" Title="winget isn't available"
                         Message="Updraft needs the Windows Package Manager (winget), which comes with Microsoft's App Installer.">
                    <InfoBar.ActionButton>
                        <HyperlinkButton Content="Get App Installer" NavigateUri="ms-windows-store://pdp/?productid=9NBLGGH4NNS1" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ListView x:Name="HistList" Grid.Row="2" ItemsSource="{x:Bind HistoryItems}" Visibility="Collapsed"
                          SelectionMode="None" Padding="12,0,8,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryEntry">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Summary}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ResultText}" Foreground="{x:Bind ResultBrush}" FontSize="12"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind WhenText}" Opacity="0.65" FontSize="11" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView x:Name="PkgList" Grid.Row="2" ItemsSource="{x:Bind Items}"
                          SelectionMode="Single" SelectionChanged="PkgList_SelectionChanged"
                          Padding="12,0,8,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Pkg">
                            <Grid Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Name}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Padding="6,0" BorderThickness="1"
                                                    Visibility="{x:Bind PinnedVisibility, Mode=OneWay}"
                                                    BorderBrush="#F59E0B">
                                                <TextBlock Text="pinned" FontSize="10" Foreground="#F59E0B" />
                                            </Border>
                                            <Border CornerRadius="8" Padding="6,0" BorderThickness="1"
                                                    Visibility="{x:Bind SkippedVisibility, Mode=OneWay}"
                                                    BorderBrush="#9D9D9D">
                                                <TextBlock Text="{x:Bind SkipLabel, Mode=OneWay}" FontSize="10" Foreground="#9D9D9D" />
                                            </Border>
                                            <Border CornerRadius="8" Padding="6,0" BorderThickness="1"
                                                    Visibility="{x:Bind InstalledVisibility, Mode=OneWay}"
                                                    BorderBrush="#22C55E">
                                                <TextBlock Text="installed" FontSize="10" Foreground="#22C55E" />
                                            </Border>
                                            <Border CornerRadius="8" Padding="6,0" BorderThickness="1"
                                                    Visibility="{x:Bind SourceVisibility}"
                                                    BorderBrush="{x:Bind SourceBrush}">
                                                <TextBlock Text="{x:Bind SourceLabel}" FontSize="10"
                                                           Foreground="{x:Bind SourceBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind Id}" /><Run Text="   ·   " /><Run Text="{x:Bind VersionText}" />
                                    </TextBlock>
                                        <ProgressBar Margin="0,4,0,0" Height="3"
                                                 Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                                 IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}"
                                                 Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" />
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                               Visibility="{x:Bind StatusVisibility, Mode=OneWay}"
                                               Text="{x:Bind RunStatus, Mode=OneWay}"
                                               Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyMsg" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6" TextAlignment="Center" />
            </Grid>

            <!-- detail pane -->
            <Border x:Name="DetailPane" Grid.Row="0" Grid.Column="1" Margin="0,16,16,8" Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="DEmpty" Text="Select a package to see details" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer x:Name="DPanel" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DId" Opacity="0.65" TextWrapping="Wrap" />
                            <TextBlock x:Name="DDesc" TextWrapping="Wrap" Margin="0,10,0,10" />

                            <TextBlock Text="Details" Opacity="0.65" FontSize="12" Margin="0,4,0,4" />
                            <Grid RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Installed" />
                                <TextBlock x:Name="DInst" Grid.Column="1" FontWeight="SemiBold" />
                                <TextBlock Text="Latest version" Grid.Row="1" />
                                <TextBlock x:Name="DLatest" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                                <TextBlock Text="Publisher" Grid.Row="2" />
                                <TextBlock x:Name="DPub" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Licence" Grid.Row="3" />
                                <TextBlock x:Name="DLic" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Homepage" Grid.Row="4" />
                                <HyperlinkButton x:Name="DHome" Grid.Row="4" Grid.Column="1" Padding="0" />
                            </Grid>

                            <TextBlock Text="Terminal command" Opacity="0.65" FontSize="12" Margin="0,16,0,4" />
                            <Border CornerRadius="6" Padding="12" Background="#1E1F24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DCmd" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                               Foreground="#D7DAE0" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button x:Name="DCopy" Grid.Column="1" Content="Copy" Click="DCopy_Click"
                                            VerticalAlignment="Top" Margin="10,0,0,0" />
                                </Grid>
                            </Border>

                            <Button x:Name="DAction" Style="{StaticResource AccentButtonStyle}" Margin="0,14,0,0"
                                    Click="DAction_Click" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <DropDownButton x:Name="DSkipMenu" Content="Skip" Visibility="Collapsed"
                                                ToolTipService.ToolTip="Hide this update from the list. Stored by Updraft only.">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem x:Name="DSkipVersion" Text="Skip this version" Click="DSkipVersion_Click" />
                                            <MenuFlyoutItem Text="Always skip this app" Click="DSkipAlways_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button x:Name="DSkip" Content="Stop skipping" Click="DSkip_Click" Visibility="Collapsed" />
                                <Button x:Name="DPin" Click="DPin_Click"
                                        ToolTipService.ToolTip="winget pin: keep this app at its current version" />
                            </StackPanel>

                            <StackPanel x:Name="DLogPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <Grid>
                                    <TextBlock Text="Output" Opacity="0.65" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="DCopyLog" Content="Copy log" HorizontalAlignment="Right" Click="DCopyLog_Click" />
                                </Grid>
                                <Border CornerRadius="6" Padding="12" Margin="0,4,0,0" Background="#1E1F24">
                                    <TextBlock x:Name="DLog" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="#D7DAE0" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- action bar -->
            <Grid x:Name="ActionBar" Grid.Row="1" Grid.ColumnSpan="2" Padding="24,10,16,10" ColumnSpacing="12"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SelectAll" Content="Select all" Click="SelectAll_Click" MinWidth="0" />
                <TextBlock x:Name="SelCount" Grid.Column="1" VerticalAlignment="Center" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                <CheckBox x:Name="AdminChk" Grid.Column="2" Content="Run as administrator" MinWidth="0" />
                <Button x:Name="CopyBtn" Grid.Column="3" Content="Copy script" Click="CopyScript_Click" IsEnabled="False" />
                <Button x:Name="RunBtn" Grid.Column="4" Click="Run_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="12" />
                        <TextBlock x:Name="RunText" Text="Run in terminal" />
                    </StackPanel>
                </Button>
                <Button x:Name="InstallBtn" Grid.Column="5" Style="{StaticResource AccentButtonStyle}" Click="Install_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Ctrl+Enter to start  ·  Esc to cancel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="InstallIcon" Glyph="&#xE768;" FontSize="12" />
                        <TextBlock x:Name="InstallText" Text="Update" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- status bar -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Padding="24,4,16,6">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Opacity="0.75" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
